# Pinned source snapshots are large; keep them out of git but KEEP the manifest.
oracle/source/*.csv
oracle/source/*.xml
oracle/source/*.zip

# Raw run captures can be large/numerous
results/**/*.jsonl
results/**/*.json
!results/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/
.env

# Editor
.vscode/
.idea/
