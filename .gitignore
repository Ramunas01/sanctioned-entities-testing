# Pinned source snapshots are large; keep them out of git but KEEP the manifest.
oracle/source/*.csv
oracle/source/*.xml
oracle/source/*.zip

# Raw run captures can be large/numerous (incl. scratch source re-downloads)
results/**/*.jsonl
results/**/*.json
results/**/*.csv
results/*.jsonl
results/*.json
results/*.csv
!results/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/
.env

# Editor
.vscode/
.idea/
results/*.txt
results/*.log
results/*.md
results/*Zone.Identifier*
